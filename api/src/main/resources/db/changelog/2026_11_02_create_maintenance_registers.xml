<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">

    <changeSet id="2026_11_02_create_maintenance_sequences" author="CMMS Team">
        <createSequence sequenceName="maintenance_booking_seq" incrementBy="50" startValue="1"/>
        <createSequence sequenceName="maintenance_work_record_seq" incrementBy="50" startValue="1"/>
    </changeSet>

    <changeSet id="2026_11_02_create_maintenance_booking_table" author="CMMS Team">
        <createTable tableName="maintenance_booking">
            <column name="id" type="BIGINT">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP"/>
            <column name="created_by" type="BIGINT"/>
            <column name="updated_by" type="BIGINT"/>
            <column name="company_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_maint_booking_company" references="company(id)"/>
            </column>
            <column name="booking_id" type="VARCHAR(50)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="date" type="TIMESTAMP"/>
            <column name="reported_by" type="VARCHAR(255)"/>
            <column name="building" type="VARCHAR(255)"/>
            <column name="floor" type="VARCHAR(255)"/>
            <column name="room" type="VARCHAR(255)"/>
            <column name="exact_location" type="VARCHAR(500)"/>
            <column name="complaint_details" type="VARCHAR(5000)"/>
            <column name="status" type="VARCHAR(50)" defaultValue="PENDING">
                <constraints nullable="false"/>
            </column>
            <column name="type_of_work" type="VARCHAR(255)"/>
            <column name="assigned_technician_id" type="BIGINT">
                <constraints foreignKeyName="fk_maint_booking_technician" references="own_user(id)"/>
            </column>
            <column name="closed_id" type="VARCHAR(100)"/>
            <column name="closed_date" type="TIMESTAMP"/>
            <column name="closing_remarks" type="VARCHAR(2000)"/>
            <column name="due_date" type="TIMESTAMP"/>
        </createTable>

        <createIndex indexName="idx_maint_booking_booking_id" tableName="maintenance_booking">
            <column name="booking_id"/>
        </createIndex>
        <createIndex indexName="idx_maint_booking_status" tableName="maintenance_booking">
            <column name="status"/>
        </createIndex>
        <createIndex indexName="idx_maint_booking_building" tableName="maintenance_booking">
            <column name="building"/>
        </createIndex>
    </changeSet>

    <changeSet id="2026_11_02_create_maintenance_work_record_table" author="CMMS Team">
        <createTable tableName="maintenance_work_record">
            <column name="id" type="BIGINT">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP"/>
            <column name="created_by" type="BIGINT"/>
            <column name="updated_by" type="BIGINT"/>
            <column name="company_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_maint_work_company" references="company(id)"/>
            </column>
            <column name="booking_id_ref" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_maint_work_booking" references="maintenance_booking(id)" deleteCascade="true"/>
            </column>
            <column name="booking_code" type="VARCHAR(50)"/>
            <column name="type_of_work" type="VARCHAR(255)"/>
            <column name="attended_by" type="VARCHAR(255)"/>
            <column name="technician_user_id" type="BIGINT">
                <constraints foreignKeyName="fk_maint_work_technician" references="own_user(id)"/>
            </column>
            <column name="starting_date" type="TIMESTAMP"/>
            <column name="finishing_date" type="TIMESTAMP"/>
            <column name="time_taken" type="VARCHAR(100)"/>
            <column name="pending_reason" type="VARCHAR(2000)"/>
            <column name="closed_id" type="VARCHAR(100)"/>
            <column name="work_details" type="VARCHAR(5000)"/>
            <column name="signature" type="TEXT"/>
            <column name="before_photo_url" type="VARCHAR(1000)"/>
            <column name="after_photo_url" type="VARCHAR(1000)"/>
        </createTable>

        <createIndex indexName="idx_maint_work_booking_ref" tableName="maintenance_work_record">
            <column name="booking_id_ref"/>
        </createIndex>
        <createIndex indexName="idx_maint_work_attended_by" tableName="maintenance_work_record">
            <column name="attended_by"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
